# ============================================
# ZeroPay Confidential — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================

# Supabase — https://supabase.com (create a free project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Brevo — https://app.brevo.com (free 300 emails/day)
BREVO_API_KEY=your_brevo_api_key
# Must match a verified sender in Brevo (Settings → Senders & IP)
BREVO_FROM_EMAIL=your@email.com
BREVO_FROM_NAME=ZeroPay Confidential

# WalletConnect — https://cloud.walletconnect.com (free)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# App URL — used for invite links (set to your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 0G Galileo Testnet RPC (public endpoint, no key needed)
NEXT_PUBLIC_0G_RPC_URL=https://evmrpc-testnet.0g.ai

# ZeroPayBatch contract — deployed to 0G Galileo testnet
NEXT_PUBLIC_BATCH_CONTRACT=your_batch_contract_address

# ArciumRegistry contract — on-chain compute attestation
NEXT_PUBLIC_ARCIUM_REGISTRY=your_arcium_registry_address
